#!/usr/bin/env python3

from __future__ import annotations

import argparse
import shutil
import struct
import sys
from pathlib import Path

ENTRY_OFFSET_FROM_PE = 40

DEFAULT_DLLS = [
    "ids_peak_afl.dll",
    "ids_peak_comfort_c.dll",
    "ids_peak_ifl.dll",
    "ids_peak_ipl.dll",
]

BASE_DLL = "ids_peak.dll"

GREEN, YELLOW, RED, DIM, RESET = "\033[32m", "\033[33m", "\033[31m", "\033[2m", "\033[0m"
if not sys.stdout.isatty():
    GREEN = YELLOW = RED = DIM = RESET = ""

class PEError(Exception):
    pass

def entry_point_offset(fh) -> tuple[int, int]:
    fh.seek(0)
    if fh.read(2) != b"MZ":
        raise PEError("not a DOS/PE image (no MZ signature)")

    fh.seek(0x3C)
    (pe_off,) = struct.unpack("<I", fh.read(4))
    fh.seek(pe_off)
    if fh.read(4) != b"PE\0\0":
        raise PEError(f"no PE signature at 0x{pe_off:X}")

    (machine,) = struct.unpack("<H", fh.read(2))
    if machine != 0x8664:
        raise PEError(f"unexpected machine type 0x{machine:04X} (expected x86-64)")

    fh.seek(pe_off + 24)
    (magic,) = struct.unpack("<H", fh.read(2))
    if magic != 0x20B:
        raise PEError(f"unexpected optional header magic 0x{magic:04X} (expected PE32+)")

    offset = pe_off + ENTRY_OFFSET_FROM_PE
    fh.seek(offset)
    (value,) = struct.unpack("<I", fh.read(4))
    return offset, value

def find_bin_dir(start: Path) -> Path | None:
    if (start / "TouchDesigner.exe").exists() or list(start.glob("ids_peak*.dll")):
        return start
    for depth in ("*/bin", "drive_c/*/bin", "drive_c/*/*/bin"):
        for cand in sorted(start.glob(depth)):
            if (cand / "TouchDesigner.exe").exists():
                return cand
    for exe in sorted(start.rglob("TouchDesigner.exe")):
        return exe.parent
    return None

def report(name: str, tag: str, colour: str, detail: str = "") -> None:
    line = f"  [{colour}{tag}{RESET}] {name}"
    if detail:
        line += f" {DIM}{detail}{RESET}"
    print(line)

def main() -> int:
    ap = argparse.ArgumentParser(
        prog="td-patch-ids-peak",
        description="Zero AddressOfEntryPoint in TouchDesigner's IDS Peak DLLs.",
    )
    ap.add_argument(
        "path",
        nargs="?",
        default=".",
        help="TouchDesigner bin directory, install directory or Wine prefix (default: .)",
    )
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument("--check", action="store_true", help="report state only (default)")
    mode.add_argument("--apply", action="store_true", help="zero the entry points")
    mode.add_argument("--restore", action="store_true", help="restore the .bak originals")
    ap.add_argument(
        "--include-base",
        action="store_true",
        help=f"also touch {BASE_DLL} (not part of the known-good fix)",
    )
    args = ap.parse_args()

    start = Path(args.path).expanduser()
    if not start.exists():
        print(f"{RED}error:{RESET} no such path: {start}", file=sys.stderr)
        return 2

    bin_dir = find_bin_dir(start)
    if bin_dir is None:
        print(f"{RED}error:{RESET} no TouchDesigner bin directory under {start}", file=sys.stderr)
        return 2

    names = list(DEFAULT_DLLS)
    if args.include_base:
        names.append(BASE_DLL)

    print(f"TouchDesigner bin: {bin_dir}")

    present = [n for n in names if (bin_dir / n).exists()]
    if not present:
        print(f"  {DIM}no ids_peak DLLs in this build — nothing to do{RESET}")
        return 0

    patched = unpatched = failed = changed = 0

    for name in present:
        path = bin_dir / name
        backup = path.with_suffix(path.suffix + ".bak")

        if args.restore:
            if not backup.exists():
                report(name, "SKIP", YELLOW, "no .bak to restore from")
                continue
            shutil.copy2(backup, path)
            report(name, "RESTORED", GREEN, f"from {backup.name}")
            changed += 1
            continue

        try:
            with open(path, "rb") as fh:
                offset, value = entry_point_offset(fh)
        except (PEError, OSError) as exc:
            report(name, "FAIL", RED, str(exc))
            failed += 1
            continue

        if value == 0:
            patched += 1
            report(name, "OK", GREEN, "entry point already 0" + (f", backup: {backup.name}" if backup.exists() else ""))
            continue

        unpatched += 1
        if not args.apply:
            report(name, "NEEDS FIX", YELLOW, f"entry point 0x{value:X} at file offset 0x{offset:X}")
            continue

        if not backup.exists():
            shutil.copy2(path, backup)
            if backup.stat().st_size != path.stat().st_size:
                report(name, "FAIL", RED, "backup is truncated, refusing to patch")
                failed += 1
                continue

        with open(path, "r+b") as fh:
            fh.seek(offset)
            fh.write(b"\0\0\0\0")
            fh.flush()
            fh.seek(offset)
            (after,) = struct.unpack("<I", fh.read(4))

        if after != 0:
            report(name, "FAIL", RED, "write did not stick")
            failed += 1
            continue

        report(name, "PATCHED", GREEN, f"0x{value:X} -> 0x0 (backup: {backup.name})")
        changed += 1

    print()
    if args.restore:
        print(f"Restored {changed} file(s).")
    elif args.apply:
        print(f"Patched {changed} file(s), {patched} already patched, {failed} failed.")
    else:
        print(f"{patched} patched, {unpatched} need the fix, {failed} unreadable.")
        if unpatched:
            print(f"Run: {sys.argv[0]} {bin_dir} --apply")

    return 1 if failed else 0

if __name__ == "__main__":
    sys.exit(main())
