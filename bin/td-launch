#!/usr/bin/env bash
#
# td-launch — start TouchDesigner in a Bottles/Wine prefix with the
# compatibility environment that is known to work on Linux.
#
# Everything it sets is documented in docs/known-issues.md. Each fix can be
# turned off individually so you can bisect a broken setup without editing
# this file.

set -uo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
ROOT=$(dirname "$(dirname "$SELF")")
# shellcheck source=../lib/td-common.sh
source "$ROOT/lib/td-common.sh"

usage() {
	cat <<EOF
Usage: td-launch [options] [-- wine args...] [file.toe]

Options:
  -b, --bottle NAME   Bottles bottle to use (default: the one with TouchDesigner)
  -p, --prefix DIR    use this WINEPREFIX directly instead of a bottle
  -e, --exe PATH      TouchDesigner.exe to run (default: found in the prefix)
  -d, --debug         verbose Wine log (+seh,+tid,+loaddll), kept for td-doctor
  -n, --dry-run       print the command and environment, run nothing
  -h, --help          this text
      --version       print version

Configuration file: $(td_config_file)
  A shell snippet. Recognised variables:
    TD_BOTTLE, TD_PREFIX, TD_EXE, TD_RUNNER
    TD_KEEP_MIMALLOC=1   do not set MIMALLOC_DISABLE_REDIRECT
    TD_KEEP_WAYLAND=1    do not blank WAYLAND_DISPLAY on a Wayland session
    TD_NO_GL_YIELD=1     do not set __GL_YIELD=USLEEP
    TD_EXTRA_ENV=(FOO=bar BAZ=qux)

The last run's log is always kept at:
  $(td_state_dir)/last-run.log
so that \`td-doctor --log\` can read it after a crash.
EOF
}

debug=0
dry_run=0
opt_bottle=""
opt_prefix=""
opt_exe=""
passthrough=()

while (( $# )); do
	case "$1" in
		-b|--bottle) opt_bottle="${2:-}"; shift 2 ;;
		-p|--prefix) opt_prefix="${2:-}"; shift 2 ;;
		-e|--exe)    opt_exe="${2:-}"; shift 2 ;;
		-d|--debug)  debug=1; shift ;;
		-n|--dry-run) dry_run=1; shift ;;
		-h|--help)   usage; exit 0 ;;
		--version)   printf 'td-launch %s\n' "$TD_VERSION"; exit 0 ;;
		--)          shift; passthrough+=("$@"); break ;;
		*)           passthrough+=("$1"); shift ;;
	esac
done

# ---------------------------------------------------------------- config ----

config=$(td_config_file)
if [[ -f "$config" ]]; then
	# shellcheck disable=SC1090
	source "$config"
fi

prefix="${opt_prefix:-${TD_PREFIX:-}}"
bottle="${opt_bottle:-${TD_BOTTLE:-}}"
exe="${opt_exe:-${TD_EXE:-}}"
runner_name="${TD_RUNNER:-}"
wine=""

# ------------------------------------------------------- locate the prefix ----

if [[ -z "$prefix" ]]; then
	data=$(td_bottles_data_dir) \
		|| die "no Bottles installation found; use --prefix to point at a Wine prefix"

	if [[ -z "$bottle" ]]; then
		# Pick the bottle that actually contains TouchDesigner. A fresh bottle
		# with no TouchDesigner in it is a very common source of confusion.
		while read -r cand; do
			[[ -n "$cand" ]] || continue
			if td_find_exe "$data/bottles/$cand" >/dev/null; then
				bottle="$cand"
				break
			fi
		done < <(td_list_bottles "$data")
		[[ -n "$bottle" ]] \
			|| die "no bottle contains TouchDesigner.exe; run td-doctor for details"
	fi

	prefix="$data/bottles/$bottle"
	[[ -d "$prefix" ]] || die "no such bottle: $bottle"

	if [[ -z "$runner_name" ]]; then
		runner_name=$(td_bottle_get "$prefix/bottle.yml" Runner) \
			|| die "cannot read Runner from $prefix/bottle.yml"
	fi
	if ! wine=$(td_find_wine "$data/runners/$runner_name"); then
		# A sys-wine-* runner lives outside the Bottles runner directory; fall
		# through to $PATH below rather than treating it as a broken bottle.
		td_runner_is_system "$runner_name" \
			|| die "no wine binary in runner '$runner_name' under $data/runners"
		warn_msg "bottle uses the system Wine ('$runner_name'); falling back to wine on \$PATH"
		wine=""
	fi
fi

# A raw --prefix, or a bottle whose runner we could not resolve, falls back to
# whatever wine is on PATH.
if [[ -z "$wine" ]]; then
	wine=$(command -v wine) \
		|| die "no wine on PATH and no Bottles runner resolved"
fi

if [[ -z "$exe" ]]; then
	exe=$(td_find_exe "$prefix") \
		|| die "no TouchDesigner.exe under $prefix/drive_c"
fi
[[ -f "$exe" ]] || die "no such executable: $exe"

# ------------------------------------------------------------ environment ----

env_args=(
	"WINEPREFIX=$prefix"
)

# The one that matters: TouchDesigner's bundled mimalloc-redirect.dll patches
# malloc for every DLL in the process, including Wine's DWrite, which faults
# with 0xc0000005 while enumerating fonts and hangs the loading project.
if [[ "${TD_KEEP_MIMALLOC:-0}" != 1 ]]; then
	env_args+=("MIMALLOC_DISABLE_REDIRECT=1")
fi

# Wine's Wayland driver is still young; forcing the X11/XWayland path avoids
# the window never becoming interactive under KDE Plasma.
if [[ "${TD_KEEP_WAYLAND:-0}" != 1 && "$(td_session_type)" == "wayland" ]]; then
	env_args+=("WAYLAND_DISPLAY=")
fi

# Keeps the NVIDIA driver from spinning on the compositor.
if [[ "${TD_NO_GL_YIELD:-0}" != 1 ]] && td_is_nvidia; then
	env_args+=("__GL_YIELD=USLEEP")
fi

if [[ "$debug" == 1 ]]; then
	env_args+=("WINEDEBUG=+seh,+tid,+loaddll")
else
	env_args+=("WINEDEBUG=${WINEDEBUG:--all}")
fi

if [[ -n "${TD_EXTRA_ENV:-}" ]]; then
	env_args+=("${TD_EXTRA_ENV[@]}")
fi

# ------------------------------------------------------- argument rewriting ----

# A .toe handed over by a file manager arrives as a Unix path, which
# TouchDesigner cannot open. Wine does not translate program arguments, so do
# it here: winepath if the runner ships it, otherwise the Z: drive, which maps
# to / in every default prefix.
td_to_windows_path() {
	local unix="$1" winepath_bin abs
	abs=$(readlink -f "$unix")
	winepath_bin="$(dirname "$wine")/winepath"
	if [[ -x "$winepath_bin" ]]; then
		local out
		# Runners print their own banners, so keep only the last line that
		# actually looks like a Windows path, and drop any CR.
		out=$(WINEPREFIX="$prefix" WINEDEBUG=-all "$winepath_bin" -w "$abs" 2>/dev/null \
			| tr -d '\r' | grep -E '^[A-Za-z]:\\' | tail -1)
		if [[ -n "$out" ]]; then
			printf '%s\n' "$out"
			return 0
		fi
	fi
	if [[ -e "$prefix/dosdevices/z:" ]]; then
		printf 'Z:%s\n' "${abs//\//\\}"
		return 0
	fi
	printf '%s\n' "$unix"
}

args=()
for arg in "${passthrough[@]}"; do
	if [[ -e "$arg" ]]; then
		args+=("$(td_to_windows_path "$arg")")
	else
		args+=("$arg")
	fi
done

# ------------------------------------------------------------------- run ----

state=$(td_state_dir)
log="$state/last-run.log"

if [[ "$dry_run" == 1 ]]; then
	printf '%sprefix%s  %s\n' "$C_BOLD" "$C_RESET" "$prefix"
	printf '%swine%s    %s\n' "$C_BOLD" "$C_RESET" "$wine"
	printf '%sexe%s     %s\n' "$C_BOLD" "$C_RESET" "$exe"
	printf '%senv%s\n' "$C_BOLD" "$C_RESET"
	printf '  %s\n' "${env_args[@]}"
	if (( ${#args[@]} )); then
		printf '%sargs%s\n' "$C_BOLD" "$C_RESET"
		printf '  %s\n' "${args[@]}"
	fi
	printf '%slog%s     %s\n' "$C_BOLD" "$C_RESET" "$log"
	exit 0
fi

mkdir -p "$state" || die "cannot create $state"
cd "$(dirname "$exe")" || die "cannot enter $(dirname "$exe")"

# stdout and stderr both go to the log so that a crash is still diagnosable
# after the terminal is gone, and PIPESTATUS keeps Wine's real exit code.
env "${env_args[@]}" "$wine" "$exe" "${args[@]}" 2>&1 \
	| tee "$log"

exit "${PIPESTATUS[0]}"
